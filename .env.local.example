# Copy this file to .env.local and fill in your real key.
# .env.local is gitignored and is only ever read on the server (API routes),
# so this key is never exposed to the browser.

# Get a free test key at https://app.duffel.com (Settings -> API tokens).
# Test keys start with "duffel_test_", live keys with "duffel_live_".
DUFFEL_API_KEY=duffel_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: three-letter IATA defaults used to pre-fill the search form.
NEXT_PUBLIC_DEFAULT_ORIGIN=SYD
NEXT_PUBLIC_DEFAULT_DESTINATION=DPS
